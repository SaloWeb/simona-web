# Copiar como .env.local para desarrollo, y cargar las mismas variables
# en Vercel (Project Settings → Environment Variables) para producción.

# API key de Resend (resend.com). Se genera en Dashboard → API Keys.
RESEND_API_KEY=

# Opcional: a dónde llegan las consultas del formulario de contacto.
# Si no se define, usa simona.agtech@gmail.com por defecto (ver
# app/api/contact/route.ts).
CONTACT_EMAIL=simona.agtech@gmail.com
